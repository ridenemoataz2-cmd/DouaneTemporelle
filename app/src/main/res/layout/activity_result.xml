<?xml version="1.0" encoding="utf-8"?>
<!-- الشاشة رقم 3: لون الخلفية يُحدَّد من الكود حسب القرار (أخضر أو أحمر) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_result_mr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- نص الرسالة: "Bon voyage" أو رسالة الاعتقال، ويُملأ من الكود -->
    <TextView
        android:id="@+id/tv_message_mr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- زر العودة إلى الاستمارة وإغلاق الشاشات السابقة -->
    <Button
        android:id="@+id/btn_nouveau_mr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Nouveau voyageur" />

</LinearLayout>