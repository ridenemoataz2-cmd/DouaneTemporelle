<?xml version="1.0" encoding="utf-8"?>
<!-- الحاوية الخارجية: ScrollView تسمح بتمرير الشاشة إذا كانت صغيرة -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ترتيب العناصر عمودياً فوق بعضها -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- عنوان التطبيق -->
        <TextView
            android:id="@+id/tv_titre_mr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Douane Temporelle"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- عنوان حقل الاسم -->
        <TextView
            android:id="@+id/tv_label_nom_mr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom du voyageur" />

        <!-- حقل كتابة اسم المسافر، والارتفاع الأدنى 48dp لسهولة اللمس -->
        <EditText
            android:id="@+id/et_nom_mr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="textPersonName"
            android:hint="Ex : Marty McFly" />

        <!-- عنوان حقل سنة الميلاد -->
        <TextView
            android:id="@+id/tv_label_naissance_mr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Année de naissance" />

        <!-- حقل سنة الميلاد: لوحة مفاتيح أرقام فقط -->
        <EditText
            android:id="@+id/et_naissance_mr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="number"
            android:hint="Ex : 1990" />

        <!-- عنوان حقل سنة الوجهة -->
        <TextView
            android:id="@+id/tv_label_destination_mr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Année de destination" />

        <!-- حقل سنة الوجهة: أرقام فقط -->
        <EditText
            android:id="@+id/et_destination_mr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="number"
            android:hint="Ex : 2050" />

        <!-- عنوان قسم سبب السفر -->
        <TextView
            android:id="@+id/tv_label_motif_mr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Motif du voyage" />

        <!-- مجموعة أزرار راديو: يمكن اختيار واحد فقط -->
        <RadioGroup
            android:id="@+id/rg_motif_mr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- الخيار 1: سياحة، وهو المحدد افتراضياً -->
            <RadioButton
                android:id="@+id/rb_tourisme_mr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tourisme" />

            <!-- الخيار 2: تعديل الماضي -->
            <RadioButton
                android:id="@+id/rb_modification_mr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modification du passé" />

            <!-- الخيار 3: هروب -->
            <RadioButton
                android:id="@+id/rb_fuite_mr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuite" />
        </RadioGroup>

        <!-- زر فحص الملف: يفتح الشاشة رقم 2 -->
        <Button
            android:id="@+id/btn_inspecter_mr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Inspecter le profil" />

    </LinearLayout>
</ScrollView>